-  unitChecks();
-  for (int i = 1; i < argc; ++i) runCase(argv[i]);
-  printf("\n%s (%d failure%s)\n", failures == 0 ? "ALL PASS" : "FAILURES",
-         failures, failures == 1 ? "" : "s");
-  return failures == 0 ? 0 : 1;
