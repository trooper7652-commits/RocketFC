+    const Vec3 vrelW = ahrs_.quat().rotate(Vec3{vtx, vty, vax2 > 0.0f ? std::sqrt(vax2) : 0.0f});
+    const float wx = velHx_ - vrelW.x, wy = velHy_ - vrelW.y;
+    const float wgt = k * k;
