-  const size_t k = meta.find(pat);
-  if (k == std::string::npos) return "";
-  size_t i = k + pat.size();
-  while (i < meta.size() && meta[i] == ' ') ++i;
-  size_t depth = 0, j = i;
-  for (; j < meta.size(); ++j) {
-    const char c = meta[j];
-    if (c == '[' || c == '{') ++depth;
-    else if (c == ']' || c == '}') {
-      if (depth == 0) break;
-      --depth;
-    } else if (c == ',' && depth == 0) break;
-  }
-  return meta.substr(i, j - i);
-}
