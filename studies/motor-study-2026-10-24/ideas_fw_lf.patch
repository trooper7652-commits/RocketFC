+#pragma once
+// GENERATED by tools/burn_table_liftoff.py on 2026-10-17 -- study candidate S2b.
+// Fire altitude minimising the WORST impact, counting lift-offs.
+namespace burntable_lo {
+
+constexpr float V_MIN = 2.0f;
+constexpr float V_STEP = 0.5f;
+constexpr int N = 47;
+
+constexpr float H_IGNITE[N] = {
+       6.75f,    7.50f,    8.30f,    9.10f,    9.95f,   10.85f,   11.80f,   12.75f,   13.75f,   14.80f,
+      15.85f,   16.95f,   18.10f,   19.25f,   20.50f,   21.65f,   22.90f,   24.20f,   25.50f,   26.85f,
+      28.20f,   29.60f,   31.05f,   32.50f,   33.95f,   35.45f,   37.00f,   38.50f,   40.10f,   41.65f,
+      43.25f,   44.90f,   46.55f,   48.20f,   49.85f,   51.50f,   53.15f,   54.80f,   56.45f,   58.05f,
+      59.70f,   61.30f,   62.90f,   64.50f,   66.10f,   67.70f,   69.30f,
+};
+
+inline float hIgnite(float vDown) {
+  if (vDown <= V_MIN) return H_IGNITE[0];
+  const float idx = (vDown - V_MIN) / V_STEP;
+  const int i = (int)idx;
+  if (i >= N - 1) return H_IGNITE[N - 1];
+  const float f = idx - (float)i;
+  return H_IGNITE[i] * (1.0f - f) + H_IGNITE[i + 1] * f;
+}
+
+}  // namespace burntable_lo
