-               dbB_.check(in.accelNormG < cfg::BURNOUT_ACCEL_G, in.dtMs,
-                          cfg::BURNOUT_MS)) {
-      landingBurnoutSeen_ = true;
-      pushEvent(in.ms, FlightEvent::LANDING_BURNOUT, in.kfAlt);
