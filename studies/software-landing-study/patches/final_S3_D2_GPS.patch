 // ---------------------------------------------------------------------------
 // Unit checks on the math the vehicle's life depends on.
 // ---------------------------------------------------------------------------
+// Landing-burn solver (src/core/landing_solver.h). Feeds `ticks` 2 ms samples
+// at constant altitude/velocity with the tilt ramping at tiltRateDegS so that
+// it reaches tiltDeg on the last tick; returns the last tick's fire decision.
+// ---------------------------------------------------------------------------
+static bool solverSteady(LandingSolver& s, float h, float v, float tiltDeg,
+                         bool healthy = true, bool cont = true, int ticks = 60,
+                         float tiltRateDegS = 0.0f) {
+  bool fire = false;
+  for (int i = 0; i < ticks; ++i) {
+    const float deg = tiltDeg + tiltRateDegS * 0.002f * (float)(i - ticks + 1);
+    fire = s.update(h, v, deg * cfg::DEG2RAD, 2.0f, healthy, cont);
+  }
+  return fire;
+}
+
+static void landingSolverChecks() {
+  printf("== landing solver checks ==\n");
+  LandingSolver::Options tableOpt;
+  tableOpt.mode = cfg::LandingSolverMode::TABLE;
+  LandingSolver::Options riskOpt;
+  riskOpt.mode = cfg::LandingSolverMode::RISK;
+
+  // TABLE mode is exactly the original inline rule.
+  {
+    int bad = 0, n = 0;
+    const float tilts[] = {0.0f, 10.0f, 14.99f, 15.0f, 20.0f};
+    for (float v = 0.0f; v <= 30.0f; v += 0.37f)
+      for (float h = 0.0f; h <= 80.0f; h += 0.53f)
+        for (float deg : tilts) {
+          LandingSolver s(tableOpt);
+          const float tilt = deg * cfg::DEG2RAD;
+          const bool got = s.update(h, -v, tilt, 2.0f, true, true);
+          bool want = false;
+          if (v >= cfg::BURN_MIN_SPEED_MS)
+            want = h <= burntable::hIgnite(v) + cfg::BURN_TABLE_MARGIN_M &&
+                   tilt < cfg::TILT_IGNITE_MAX_DEG * cfg::DEG2RAD;
+          bad += got != want;
+          ++n;
+        }
+    CHECK(bad == 0, "solver TABLE mode = original rule (%d/%d mismatches)", bad, n);
+  }
+
+  // Lag compensation, analytic: h + v tau, v + (-g + k v^2) tau.
+  {
+    LandingSolver::Options o = riskOpt;
+    o.lagTauS = 0.02f;
+    LandingSolver s(o);
+    s.update(30.0f, -15.0f, 0.0f, 2.0f, true, true);
+    const float k = 0.5f * 1.225f * cfg::CDA_M2 / cfg::MASS_DESCENT_KG;
+    const float hc = 30.0f - 15.0f * 0.02f;
+    const float vc = -15.0f + (-cfg::G0 + k * 225.0f) * 0.02f;
+    CHECK(std::fabs(s.hNow() - hc) < 1e-4f && std::fabs(s.vDown() + vc) < 1e-4f,
+          "solver lag compensation: h %.4f (want %.4f), vDown %.4f (want %.4f)",
+          s.hNow(), hc, s.vDown(), -vc);
+  }
+
+  // Analytic freefall from rest at 60 m, no lag, no tilt: fires on the first
+  // tick at or below the table's fire altitude for the current speed.
+  {
+    LandingSolver::Options o = riskOpt;
+    o.lagTauS = 0.0f;
+    LandingSolver s(o);
+    float t = 0.0f, hFired = -1.0f, vFired = 0.0f;
+    for (int i = 0; i < 5000 && hFired < 0.0f; ++i, t += 0.002f) {
+      const float h = 60.0f - 0.5f * cfg::G0 * t * t;
+      const float v = -cfg::G0 * t;
+      if (s.update(h, v, 0.0f, 2.0f, true, true)) {
+        hFired = h;
+        vFired = v;
+      }
+    }
+    const float want = landingtable::hFire(-vFired);
+    // one 2 ms tick = the fall (v dt) plus the table's rise with speed (~0.06 m)
+    CHECK(hFired > 0.0f && hFired <= want && want - hFired < 0.15f,
+          "solver freefall: fired at %.3f m / %.2f m/s, table says %.3f m",
+          hFired, -vFired, want);
+  }
+
+  // Monotonic: the required fire altitude never drops as descent speed rises.
+  {
+    LandingSolver::Options o = riskOpt;
+    o.lagTauS = 0.0f;
+    float prev = -1.0f;
+    int bad = 0;
+    for (float v = 2.0f; v <= 30.0f; v += 0.05f) {
+      LandingSolver s(o);
+      s.update(500.0f, -v, 0.0f, 2.0f, true, true);
+      if (s.hReq() < prev - 1e-4f) ++bad;
+      prev = s.hReq();
+    }
+    CHECK(bad == 0, "solver fire altitude rises with descent speed (%d drops)", bad);
+  }
+
+  // Slow descent never fires; very fast descent clamps to the table end.
+  {
+    LandingSolver slow(riskOpt), lo(riskOpt), hi(riskOpt);
+    const bool slowFire = solverSteady(slow, 0.5f, -1.0f, 0.0f);
+    const bool loFire = solverSteady(lo, 10.0f, -40.0f, 0.0f);
+    const bool hiFire = solverSteady(hi, 500.0f, -40.0f, 0.0f);
+    CHECK(!slowFire && loFire && !hiFire && std::isfinite(lo.hReq()),
+          "solver: 1 m/s never fires; 40 m/s aims at the table end (%.1f m)",
+          lo.hReq());
+  }
+
+  // NaN state, unhealthy filter or no continuity: never fire.
+  {
+    const float nan = std::nanf("");
+    LandingSolver a(riskOpt), b(riskOpt), c(riskOpt), d(riskOpt), e(riskOpt),
+        f(tableOpt);
+    const bool any = solverSteady(a, nan, -15.0f, 0.0f) ||
+                     solverSteady(b, 5.0f, nan, 0.0f) ||
+                     solverSteady(c, 5.0f, -15.0f, nan) ||
+                     solverSteady(d, 5.0f, -15.0f, 0.0f, false) ||
+                     solverSteady(e, 5.0f, -15.0f, 0.0f, true, false) ||
+                     solverSteady(f, nan, nan, 0.0f);
+    CHECK(!any, "solver: NaN inputs, unhealthy KF or no continuity -> no fire");
+  }
+
+  // Tilt at the limit (predictive interlock off): 14.9 deg fires, 15.0 doesn't.
+  {
+    LandingSolver a(riskOpt), b(riskOpt);
+    CHECK(solverSteady(a, 5.0f, -15.0f, 14.9f) && !solverSteady(b, 5.0f, -15.0f, 15.0f),
+          "solver: 14.9 deg fires, 15.0 deg blocks");
+  }
+
+  // Tilt-rate estimate and the tilt predicted at thrust onset.
+  {
+    LandingSolver s(riskOpt);
+    solverSteady(s, 500.0f, -15.0f, 20.0f, true, true, 400, -8.0f);
+    const float rate = s.tiltRateRadS() * cfg::RAD2DEG;
+    const float on = s.tiltOnRad() * cfg::RAD2DEG;
+    const float wantOn = 20.0f - 8.0f * cfg::IGNITION_DELAY_MS * 0.001f;
+    CHECK(std::fabs(rate + 8.0f) < 0.3f && std::fabs(on - wantOn) < 0.3f,
+          "solver tilt rate %.2f deg/s (want -8), tilt at onset %.2f (want %.2f)",
+          rate, on, wantOn);
+  }
+
+  // Predictive interlock: allows 17 deg falling 10 deg/s (12 at onset), but
+  // not 17 deg steady, not above the hard cap, and never when switched off.
+  {
+    LandingSolver::Options o = riskOpt;
+    o.predictInterlock = true;
+    o.hardMaxDeg = 25.0f;
+    LandingSolver a(o), b(o), c(o), d(riskOpt);
+    const bool falling = solverSteady(a, 5.0f, -15.0f, 17.0f, true, true, 200, -10.0f);
+    const bool steady = solverSteady(b, 5.0f, -15.0f, 17.0f, true, true, 200, 0.0f);
+    const bool overCap = solverSteady(c, 5.0f, -15.0f, 26.0f, true, true, 200, -30.0f);
+    const bool off = solverSteady(d, 5.0f, -15.0f, 17.0f, true, true, 200, -10.0f);
+    CHECK(falling && !steady && !overCap && !off,
+          "solver predicted-tilt interlock: falling %d, steady %d, over cap %d, off %d "
+          "(want 1 0 0 0)", falling, steady, overCap, off);
+  }
+
+  // Zero lag, zero dispersion: landing_table.h's nominal column is the same
+  // physics as burn_table.py's table (within that table's 5 cm search grid).
+  {
+    float worst = 0.0f;
+    int n = 0;
+    for (int i = 0; i < landingtable::N; ++i) {
+      const float v = landingtable::V_MIN + (float)i * landingtable::V_STEP;
+      const float hn = landingtable::H_NOMINAL[i];
+      if (hn < 0.0f) continue;  // nominal rocket can't stop from this speed
+      const float d = std::fabs(hn - burntable::hIgnite(v));
+      if (d > worst) worst = d;
+      ++n;
+    }
+    CHECK(n >= 30 && worst < 0.10f,
+          "landing_table.h nominal column matches burn_table.h (%d rows, worst %.3f m)",
+          n, worst);
+  }
+}
