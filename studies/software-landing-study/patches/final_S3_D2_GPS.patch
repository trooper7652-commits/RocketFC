+#pragma once
+// GENERATED by tools/landing_table.py on 2026-10-12 -- DO NOT EDIT BY HAND.
+//   motor Estes_F15.eng, mass 0.950 kg, CdA 0.0040 m^2,
+//   ignition delay 500 ms
+//   uncertainty: delay +-15 %, mass +-5 %, CdA +-20 %,
+//   thrust sd 1.7 %, estimator residual h -0.01+-0.03 m,
+//   v +0.02+-0.04 m/s; hop penalty 0 m/s;
+//   2000 draws per row; tilt recovery tau 0.15 s
+// Per descent speed (m/s, downward-positive):
+//   H_FIRE    fire altitude (m) minimizing the expected touchdown speed
+//   H_NOMINAL exact stop altitude of the nominal rocket (-1 = can't stop)
+//   TILT_COEF extra fall distance per rad^2 of tilt at thrust onset (m/rad^2)
+namespace landingtable {
+
+constexpr float V_MIN = 2.0f;
+constexpr float V_STEP = 0.5f;
+constexpr int N = 47;
+
+constexpr float H_FIRE[N] = {
+     5.450f,    6.060f,    6.740f,    7.410f,    8.250f,    9.100f,    9.860f,   10.780f,
+    11.490f,   12.537f,   13.431f,   14.498f,   15.388f,   16.530f,   17.613f,   19.047f,
+    20.032f,   20.836f,   23.070f,   24.302f,   25.931f,   27.097f,   28.789f,   30.307f,
+    31.589f,   33.615f,   35.764f,   37.345f,   38.529f,   40.533f,   42.019f,   43.885f,
+    45.444f,   46.585f,   48.331f,   50.509f,   51.711f,   53.545f,   55.122f,   56.852f,
+    58.056f,   59.832f,   61.482f,   63.045f,   64.521f,   65.970f,   67.423f,
+};
+
+constexpr float H_NOMINAL[N] = {
+     6.698f,    7.455f,    8.245f,    9.069f,    9.928f,   10.821f,   11.748f,   12.710f,
+    13.707f,   14.737f,   15.801f,   16.898f,   18.028f,   19.190f,   20.383f,   21.607f,
+    22.862f,   24.146f,   25.460f,   26.802f,   28.171f,   29.567f,   30.989f,   32.437f,
+    33.909f,   35.405f,   36.924f,   38.465f,   40.029f,   41.613f,   43.219f,   44.845f,
+    46.494f,   -1.000f,   -1.000f,   -1.000f,   -1.000f,   -1.000f,   -1.000f,   -1.000f,
+    -1.000f,   -1.000f,   -1.000f,   -1.000f,   -1.000f,   -1.000f,   -1.000f,
+};
+
+constexpr float TILT_COEF[N] = {
+     0.132f,    0.142f,    0.153f,    0.165f,    0.176f,    0.187f,    0.199f,    0.210f,
+     0.222f,    0.233f,    0.244f,    0.255f,    0.266f,    0.277f,    0.287f,    0.298f,
+     0.308f,    0.318f,    0.328f,    0.338f,    0.348f,    0.357f,    0.366f,    0.375f,
+     0.383f,    0.392f,    0.400f,    0.408f,    0.416f,    0.424f,    0.431f,    0.439f,
+     0.448f,    0.000f,    0.000f,    0.000f,    0.000f,    0.000f,    0.000f,    0.000f,
+     0.000f,    0.000f,    0.000f,    0.000f,    0.000f,    0.000f,    0.000f,
+};
+
+// Linear interpolation in a table, clamped to its domain.
+inline float lookup(const float* t, float vDown) {
+  if (!(vDown > V_MIN)) return t[0];  // also catches NaN
+  const float idx = (vDown - V_MIN) / V_STEP;
+  if (idx >= (float)(N - 1)) return t[N - 1];
+  const int i = (int)idx;
+  const float f = idx - (float)i;
+  return t[i] * (1.0f - f) + t[i + 1] * f;
+}
+inline float hFire(float vDown) { return lookup(H_FIRE, vDown); }
+inline float tiltCoef(float vDown) { return lookup(TILT_COEF, vDown); }
+
