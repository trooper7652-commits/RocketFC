-
-  FlightState state_ = FlightState::IDLE;
-  cfg::FlightMode mode_ = cfg::DEFAULT_MODE;
-  AbortReason abortReason_ = AbortReason::NONE;
-  uint32_t entryMs_ = 0, launchMs_ = 0, landFireMs_ = 0;
