diff -ru a/src/config.h b/src/config.h
--- a/src/config.h	2026-11-20 11:58:58.113428060 +0000
+++ b/src/config.h	2026-11-20 11:58:58.138909020 +0000
@@ -191,6 +191,21 @@
 constexpr float DRIFT_MAX_TILT_DEG = 5.0f;   // cap on the commanded lean
 
 // ---------------------------------------------------------------------------
+// Wind-matched ascent (study 2026-11-20, from software-landing-study new-ideas
+// s4): estimate the wind from the accelerometer during BOOST and lean the TVC
+// target so the rocket reaches burnout moving with the air.
+// ---------------------------------------------------------------------------
+constexpr int   WIND_MATCH_ASCENT = 0;         // 1 = on, 0 = off (today's behaviour)
+constexpr float WMA_GAIN = 1.0f;               // 1/s: lean = -gain * (sideways vel - wind) / accel
+constexpr float WMA_MAX_TILT_DEG = 5.0f;       // cap on the commanded boost lean
+constexpr float WMA_START_S = 0.3f;            // lean only after this long into BOOST
+constexpr float WMA_END_S = 0.6f;              // ...and stand upright this long before ASCENT_BURN_MS
+constexpr float WMA_CNA_AREF_M2 = 0.00884f;    // [ESTIMATE] CN_alpha (2/rad) * A_ref (75 mm tube), m^2
+constexpr float WMA_SCALE = 0.8f;              // scale the estimate low: reading low is the safe error
+constexpr float WMA_MIN_SPEED_MS = 4.0f;       // airspeed below this: no estimate sample
+constexpr float WMA_PRIOR_MPS = 1.0f;          // prior wind spread: shrinks a noisy estimate toward 0; 0 = off
+
+// ---------------------------------------------------------------------------
 // Parachute release servo. The chute is pushed out by a spring; this servo
 // holds the latch. FlightStateMachine decides WHEN (apogee in CHUTE_TEST, any
 // abort in either mode); ChuteDeploy (src/core/chute_deploy.h) then confirms
