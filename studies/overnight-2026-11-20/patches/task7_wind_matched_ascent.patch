       ctl_.update(e.x, e.y, in.gyro.x, in.gyro.y, in.dt, true);
     } else if (wasActive_) {
       ctl_.reset();  // clean integrators/slew state for the next burn phase
@@ -158,6 +177,62 @@
   }
 
  private:
+  // Wind estimate during BOOST (one sample per tick). The airframe is fin-less
+  // and its normal force is ~ 0.5 rho |V| (CNa Aref) * crossflow, so:
+  //   1. sideways specific force minus the gimbal's share of the thrust = the
+  //      aerodynamic normal force / m = -k * (rocket velocity relative to air,
+  //      sideways), with k = 0.5 rho CNa Aref / m * airspeed;
+  //   2. rotate that body-frame relative velocity to the world frame (axial part
+  //      from the airspeed) and subtract it from the dead-reckoned rocket
+  //      velocity -> one wind sample;
+  //   3. average samples weighted by k^2 (a stronger airflow is a better
+  //      measurement), shrink toward 0 by the sample noise measured from
+  //      successive differences against WMA_PRIOR_MPS, and scale by WMA_SCALE
+  //      (reading low is the safe error).
+  void windEstStep(const CoreInput& in) {
+    const float az = in.accel.z;                    // ~thrust / mass
+    if (az < 3.0f) return;
+    // body: fx = -T sin(gimbalY), fy = +T sin(gimbalX)
+    const float nx = in.accel.x + az * std::sin(ctl_.gimbalY());
+    const float ny = in.accel.y - az * std::sin(ctl_.gimbalX());
+    const float vUp = kf_.velocity();
+    const float dwx = velHx_ - windX_, dwy = velHy_ - windY_;
+    const float speed = std::sqrt(vUp * vUp + dwx * dwx + dwy * dwy);
+    if (speed < cfg::WMA_MIN_SPEED_MS) return;
+    const float k = 0.5f * 1.225f * cfg::WMA_CNA_AREF_M2 / cfg::MASS_DESCENT_KG * speed;
+    const float vtx = -nx / k, vty = -ny / k;
+    const float vax2 = speed * speed - vtx * vtx - vty * vty;
+    const Vec3 vrelW = ahrs_.quat().rotate(Vec3{vtx, vty, vax2 > 0.0f ? std::sqrt(vax2) : 0.0f});
+    const float wx = velHx_ - vrelW.x, wy = velHy_ - vrelW.y;
+    const float wgt = k * k;
+    windSx_ += wgt * wx;
+    windSy_ += wgt * wy;
+    windSw_ += wgt;
+    float shrink = 1.0f;
+    if (cfg::WMA_PRIOR_MPS > 0.0f) {
+      if (windNn_ > 0) {
+        const float ddx = nx - windPnx_, ddy = ny - windPny_;
+        windNv_ += 0.25f * (ddx * ddx + ddy * ddy);
+        ++windNn_;
+      } else {
+        windNn_ = 1;
+      }
+      windPnx_ = nx;
+      windPny_ = ny;
+      const float nv = windNn_ > 1 ? windNv_ / (float)(windNn_ - 1) : 1.0f;
+      const float pv = cfg::WMA_PRIOR_MPS * cfg::WMA_PRIOR_MPS;
+      shrink = windSw_ / (windSw_ + nv / pv);
+    }
+    windX_ = cfg::WMA_SCALE * shrink * windSx_ / windSw_;
+    windY_ = cfg::WMA_SCALE * shrink * windSy_ / windSw_;
+  }
+
+  uint32_t boostMs_ = 0;
+  float windX_ = 0.0f, windY_ = 0.0f;                       // wind estimate (m/s, world x/y)
+  float windSx_ = 0.0f, windSy_ = 0.0f, windSw_ = 0.0f;     // weighted sums
+  float windPnx_ = 0.0f, windPny_ = 0.0f, windNv_ = 0.0f;   // noise tracking
+  int windNn_ = 0;
+
   Ahrs ahrs_;
   AltitudeKf kf_;
   TvcControl ctl_;
