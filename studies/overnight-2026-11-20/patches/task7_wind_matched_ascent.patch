         }
       }
+      if (cfg::WIND_MATCH_ASCENT != 0 && fo.state == FlightState::BOOST) {
+        windEstStep(in);
+        // Lean toward the wind-matched velocity; upright outside [START, burn - END].
+        if (!wasActive_) boostMs_ = in.ms;
+        const float tb = (in.ms - boostMs_) * 0.001f;
+        const float aT = in.accel.norm();
+        if (aT > 3.0f && tb >= cfg::WMA_START_S &&
